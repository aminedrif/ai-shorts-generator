# LLM Provider: gemini or openai
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Whisper Configuration
# Available model sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
# Device: auto, cpu, or cuda
WHISPER_DEVICE=auto
# Compute type: int8, float16, float32 (use int8 for CPU, float16 for CUDA GPU)
WHISPER_COMPUTE_TYPE=int8

# Video Output Configuration
OUTPUT_DIR=output
TEMP_DIR=temp
# Video Encoder: auto, nvenc, or libx264
VIDEO_ENCODER=auto
DEFAULT_ASPECT_RATIO=9:16
SUBTITLE_FONT_SIZE=24
SUBTITLE_PRIMARY_COLOR=&H00FFFFFF
SUBTITLE_OUTLINE_COLOR=&H00000000
